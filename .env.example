# Скопируй:  cp .env.example .env
# Потом:     nano .env

# === ГЛАВНОЕ (бесплатно, для Termux) ===
# https://console.groq.com/keys
GROQ_API_KEY=gsk_вставь_сюда

# === Не обязательно ===
# Если OPENAI ключ битый — лучше удали строку совсем
# OPENAI_API_KEY=
# TELEGRAM_BOT_TOKEN=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
DISCORD_ALLOWED_USER_IDS=
# Multi-LLM (optional)
# IDA_LLM_PROVIDER=groq
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
