# IDA AI Agent — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ======================
# LLM Providers (нужен хотя бы один)
# ======================
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...

# Опционально другие провайдеры
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=

# Кастомный OpenAI-совместимый endpoint
# OPENAI_API_BASE=https://api.openai.com/v1

# Модель по умолчанию
# IDA_MODEL=llama-3.3-70b-versatile

# ======================
# Telegram
# ======================
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=

# ======================
# Database (опционально)
# ======================
# DATABASE_URL=postgresql://...

# ======================
# Logging
# ======================
# IDA_LOG_LEVEL=INFO
```
