# IDA AI Agent — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# OpenAI API key (required for LLM features)
OPENAI_API_KEY=sk-...

# Optional: LLM provider backend (see the `providers` package)
# Supported: openai (any OpenAI-compatible endpoint), ollama (local)
# IDA_LLM_PROVIDER=openai

# Optional: custom OpenAI-compatible base URL
# For a local Ollama server set IDA_LLM_PROVIDER=ollama (defaults to
# http://localhost:11434/v1) or point OPENAI_API_BASE at any compatible API.
# OPENAI_API_BASE=https://api.openai.com/v1

# Optional: override default LLM model
# Available: gpt-5-nano, gpt-5-mini, gpt-5
# IDA_MODEL=gpt-5-mini

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
# IDA_LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=your_token_here
ALLOWED_USER_IDS=your_id_here
